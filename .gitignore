# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtualenvs
.venv/
venv/

# Distribution / build
dist/
build/
*.egg-info/

# OS / editor
.DS_Store
*.swp
*.swo

# Marimo cache (do NOT commit)
notebooks/__marimo__/

# DLT pipeline state + stedding root (do NOT commit — runtime caches)
stedding/
# Explicit exclusions for known stedding subtrees (defence-in-depth)
!stedding/.gitkeep

# OSINT allowlist is NOT in .gitignore (it's the canonical licence surface)

# BAML generated client (run `baml-cli generate` to produce)
baml_client/

# CocoIndex state
.cocoindex/
